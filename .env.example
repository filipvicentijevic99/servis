# Kopiraj u .env.local. Bazu najlakše povežeš sa: neon init (sam upisuje ove promenljive)
# Pooled konekcija za aplikaciju, direktna (unpooled) za Prisma migracije
DATABASE_URL="postgresql://user:password@host-pooler/servis?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/servis?sslmode=require"

# Better Auth
# Generiši tajnu sa: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google login (opciono; bez ovoga radi samo email + lozinka)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
