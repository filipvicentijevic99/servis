# Copy to .env.local. Easiest way to connect the database: neon init (writes these for you)
# Pooled connection for the app, direct (unpooled) for Prisma migrations
DATABASE_URL="postgresql://user:password@host-pooler/servis?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/servis?sslmode=require"

# Better Auth
# Generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google login (optional; without it only email + password works)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
