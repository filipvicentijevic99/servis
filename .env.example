# Copy to .env.local. Easiest way to connect the database: neon init (writes these for you)
# Pooled connection for the app, direct (unpooled) for Prisma migrations
DATABASE_URL="postgresql://user:password@host-pooler/servis?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/servis?sslmode=verify-full"

# Better Auth
# Generate a secret with: npx auth@latest secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google login (optional; without it only email + password works)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Booking emails (optional; without a key emails are skipped and only logged)
# API key from https://resend.com. The default sender onboarding@resend.dev can only
# deliver to the Resend account's own address; verify a domain to email everyone.
RESEND_API_KEY=""
EMAIL_FROM=""
